# /etc/suricata/threshold.config — Hand-Me-Down Homelab, section 11.3.
#
# Suppressions and rate limits for a home IDS on a passive tap (a switch
# mirror port). Every entry is here for a reason written beside it; keep
# doing that in yours. Addresses are the book's example network: replace
# them with your own. Reload after editing:  sudo suricatasc -c reload-rules
#
# Syntax (see the Suricata docs, "Global thresholds"):
#   suppress  gen_id <gid>, sig_id <sid>
#   suppress  gen_id <gid>, sig_id <sid>, track <by_src|by_dst>, ip <ip|cidr>
#   threshold gen_id <gid>, sig_id <sid>, type <limit|threshold|both>,
#             track <by_src|by_dst>, count <n>, seconds <t>
#
# Two rules from the book:
#   1. Suppress as narrowly as possible: one signature, one host, one
#      direction. A blanket suppression hides the attack the rule exists for.
#   2. Prove each suppression matches: after reloading, check that the alert
#      count for that signature actually drops.

# ── 1. Tap artifacts: stream and decoder noise ──────────────────────────────
# A mirror port drops packets under load, and Suricata then sees retransmits,
# bad acks and odd checksums that never happened on the wire. These SIDs are
# protocol-anomaly rules (the 22xxxxx range), not attack signatures. Check
# each against your own alerts before copying it: if a SID never fires for
# you, don't suppress it.
suppress gen_id 1, sig_id 2210054   # STREAM invalid timestamp
suppress gen_id 1, sig_id 2210044   # STREAM excessive retransmissions
suppress gen_id 1, sig_id 2200073   # TIMEWAIT ACK with wrong seq
suppress gen_id 1, sig_id 2200075   # TCPv4 invalid checksum
suppress gen_id 1, sig_id 2210042   # UDP packet too small / invalid checksum
suppress gen_id 1, sig_id 2260001   # app-layer: wrong direction first data
suppress gen_id 1, sig_id 2210029   # STREAM packet with invalid ack
suppress gen_id 1, sig_id 2210030   # STREAM ESTABLISHED invalid ack
suppress gen_id 1, sig_id 2210045   # STREAM SHUTDOWN RST invalid ack
suppress gen_id 1, sig_id 2210046   # STREAM invalid ack, misc
suppress gen_id 1, sig_id 2260002   # app-layer: protocol seen in one direction only
suppress gen_id 1, sig_id 2210023   # STREAM SYN/ACK resend
suppress gen_id 1, sig_id 2224009   # IKE invalid proposal
suppress gen_id 1, sig_id 2221050   # HTTP too many warnings (large transfers)
suppress gen_id 1, sig_id 2221034   # HTTP unrecognized auth (one app's push SDK)
suppress gen_id 1, sig_id 2210020
suppress gen_id 1, sig_id 2210038
suppress gen_id 1, sig_id 2200074
suppress gen_id 1, sig_id 2210064
suppress gen_id 1, sig_id 2221049
suppress gen_id 1, sig_id 2210017
suppress gen_id 1, sig_id 2210056
suppress gen_id 1, sig_id 2210016
suppress gen_id 1, sig_id 2210026
suppress gen_id 1, sig_id 2210024
suppress gen_id 1, sig_id 2230010
suppress gen_id 1, sig_id 2231000
suppress gen_id 1, sig_id 2231001

# ── 2. Scope to internal sources: SSDP "amplification scan" ─────────────────
# sid 2019102 is written "udp any any -> $HOME_NET 1900", so ordinary UPnP
# discovery from your own devices to the gateway trips it. It appeared the
# day the tap moved to the LAN mirror, which made LAN-to-LAN traffic visible.
# Suppressing only private SOURCES keeps a real external scan alerting.
suppress gen_id 1, sig_id 2019102, track by_src, ip 192.168.0.0/16
suppress gen_id 1, sig_id 2019102, track by_src, ip 10.0.0.0/8
suppress gen_id 1, sig_id 2019102, track by_src, ip 172.16.0.0/12

# ── 3. Direction matters: STUN from Tailscale's NAT traversal ───────────────
# Home Assistant (the tailnet's subnet router, .172) and the Apple TV (its
# exit node, .153) probe Tailscale's relays all day, tens of thousands of
# alerts. 2016149 is the Binding REQUEST, which your host sends: your host is
# the alert's source, so track by_src. 2016150 is the RESPONSE, which comes
# back from the relay: your host is the DESTINATION, so a by_src line can
# never match it. My first version wrote both by_src, and half the fix
# silently did nothing.
suppress gen_id 1, sig_id 2016149, track by_src, ip 192.168.7.172
suppress gen_id 1, sig_id 2016149, track by_src, ip 192.168.7.153
suppress gen_id 1, sig_id 2016150, track by_dst, ip 192.168.7.172
suppress gen_id 1, sig_id 2016150, track by_dst, ip 192.168.7.153

# ── 4. Scope to one flow: stream reassembly overlap ─────────────────────────
# sid 2210050 exists to catch TCP injection (overlapping segments carrying
# different data). On a tap that drops packets, long, busy flows produce it
# as an artifact. Two such flows here:
#  - every camera streaming to the video recorder (.52): scoped by_dst to the
#    recorder, so overlaps anywhere else still alert;
#  - Home Assistant's UniFi integration, a websocket from the gateway (.1)
#    carrying ~17 GB a day. Alert bursts land each time the 32-bit TCP
#    sequence number wraps (every ~4.5 GB). Scoped by_src to the gateway,
#    the tighter of the two options.
suppress gen_id 1, sig_id 2210050, track by_dst, ip 192.168.4.52
suppress gen_id 1, sig_id 2210050, track by_src, ip 192.168.4.1

# ── 5. Rate-limit instead of suppress: STUN from everyone else ──────────────
# Phones and laptops do the same NAT traversal, and their addresses change
# (new networks, randomized MACs), so per-host suppressions can't keep up.
# A limit works whatever the address and still shows one alert per host per
# hour, so a compromised device using STUN for command-and-control stays
# visible. Same direction split as section 3.
threshold gen_id 1, sig_id 2016149, type limit, track by_src, count 1, seconds 3600
threshold gen_id 1, sig_id 2016150, type limit, track by_dst, count 1, seconds 3600
